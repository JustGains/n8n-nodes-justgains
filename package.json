{
	"name": "n8n-nodes-justgains",
	"version": "0.1.1",
	"description": "n8n node for JustGains: log workouts, food and bodyweight, and read your training history, progress and insights",
	"license": "MIT",
	"homepage": "https://github.com/JustGains/n8n-nodes-justgains",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"justgains",
		"fitness",
		"workout",
		"nutrition",
		"strength training"
	],
	"author": {
		"name": "JustGains",
		"email": "james@justsuperhuman.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JustGains/n8n-nodes-justgains.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/JustGainsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/JustGains/JustGains.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
